@using PluginBuilder.DataModels
@model PluginBuilder.Controllers.PublisherTokenSettingsController.TokenPage
@{
    Layout = "_Layout";
    ViewData.SetActivePage("Account Settings");
    ViewData["Title"] = "API tokens";
    var now = DateTimeOffset.UtcNow;
    var apiBase = $"{Context.Request.Scheme}://{Context.Request.Host}/api/v1";
}

<div id="PublisherTokens">
    <h2 class="mt-1 mb-2">@ViewData["Title"]</h2>
    <p class="text-muted mb-4">
        Let an automation or AI agent publish one of your plugins without your password. Each token reaches only the plugin
        you choose, through the plugin API, and works for accounts with two-factor authentication. It stops working when
        you revoke it, when it expires, or when your password changes.
    </p>

    @if (Model.Issued is { } issued)
    {
        <div id="TokenSuccess" class="alert alert-success">
            <p class="mb-2"><strong>Token created for @issued.PluginSlug.</strong> Save it now: it will not be shown again.</p>
            <label for="IssuedToken" class="form-label">Your token</label>
            <input id="IssuedToken" class="form-control font-monospace mb-2" value="@issued.Token" readonly autocomplete="off" spellcheck="false" />
            <p class="small mb-0">Use it as <code>Authorization: Bearer &lt;token&gt;</code>, for example
                <code>curl -H "Authorization: Bearer &lt;token&gt;" @apiBase/plugins/@issued.PluginSlug/builds</code></p>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h4 class="card-title">Create a token</h4>
            @if (Model.Plugins.Count == 0)
            {
                <p id="NoPlugins" class="text-muted mb-0">Tokens belong to a plugin. Create a plugin first, then come back here.</p>
            }
            else
            {
                <form id="CreateTokenForm" asp-action="Create" method="post">
                    <div id="TokenValidation" asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="Creation.Name" class="form-label">Token name</label>
                            <input asp-for="Creation.Name" class="form-control" maxlength="100" placeholder="e.g. GitHub Actions release" autocomplete="off" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Creation.PluginSlug" class="form-label">Plugin</label>
                            <select asp-for="Creation.PluginSlug" class="form-select" required>
                                @foreach (var plugin in Model.Plugins)
                                {
                                    <option value="@plugin">@plugin</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Creation.ExpiresInDays" class="form-label">Expires in</label>
                            <select asp-for="Creation.ExpiresInDays" class="form-select">
                                @foreach (var days in PluginBuilder.Services.PublisherAccessTokenService.LifetimeChoices)
                                {
                                    <option value="@days">@days days</option>
                                }
                                <option value="0">Never</option>
                            </select>
                        </div>
                    </div>
                    <button id="CreateToken" class="btn btn-primary mt-3" type="submit">Create token</button>
                </form>
            }
        </div>
    </div>

    <div id="TokenList">
        @if (Model.Tokens.Count == 0)
        {
            <p class="text-muted">No tokens yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th>Plugin</th><th>Created</th><th>Last used</th><th>Expires</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                    @foreach (var token in Model.Tokens)
                    {
                        var status = token.RevokedAt is not null ? "Revoked" : token.ExpiresAt is { } expires && expires <= now ? "Expired" : "Active";
                        <tr data-token-id="@token.Id">
                            <td class="text-break" data-token-name>@token.Name</td>
                            <td><code>@token.PluginSlug</code></td>
                            <td class="text-nowrap" title="@token.CreatedAt.ToString("u")">@token.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-nowrap" title="@token.LastUsedAt?.ToString("u")">@(token.LastUsedAt is { } used ? (now - used).ToTimeAgo() : "Never")</td>
                            <td class="text-nowrap" title="@token.ExpiresAt?.ToString("u")">@(token.ExpiresAt?.ToString("yyyy-MM-dd") ?? "Never")</td>
                            <td><span data-token-status class="badge @(status == "Active" ? "bg-success" : status == "Expired" ? "bg-warning" : "bg-secondary")">@status</span></td>
                            <td class="text-end">
                                @if (token.RevokedAt is null)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#ConfirmModal" data-action="@Url.Action("Revoke", new { id = token.Id })" data-title="Revoke @token.Name?">Revoke</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section FooterScripts {
    <partial name="_Confirm" model='new ConfirmModel("Revoke token", "The token stops working immediately. Requests already running may finish. This cannot be undone.", "Revoke token")' />
}
