@using PluginBuilder.DataModels
@model PluginBuilder.Controllers.PublisherTokenSettingsController.TokenPage
@{
    Layout = "_Layout";
    ViewData.SetActivePage("Account Settings", title: "API tokens");
    var now = DateTimeOffset.UtcNow;
    var active = Model.Tokens.Where(token => token.RevokedAt is null && !token.Invalidated && (token.ExpiresAt is null || token.ExpiresAt > now)).ToArray();
    var inactive = Model.Tokens.Except(active).ToArray();
}

<div id="PublisherTokens">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <h1 class="mb-0">@ViewData["Title"]</h1>
        <button id="CreateToken" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#CreateTokenModal" disabled="@(Model.Plugins.Count == 0)">Create token</button>
    </div>
    <partial name="~/Views/Account/_AccountNav.cshtml" />
    <p class="text-muted mb-4">Connect CI or an automation to the plugin API. Each token can manage builds and versions for one plugin.</p>
    @if (Model.Plugins.Count == 0)
    {
        <p id="NoPlugins" class="text-muted">Create a plugin before creating an API token.</p>
    }

    <div id="TokenList">
        <div class="d-flex justify-content-end mb-3">
            <div class="dropdown">
                <button id="TokenStatusFilter" class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Status: Active</button>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="TokenStatusFilter">
                    <button type="button" class="dropdown-item active" data-token-filter="ActiveTokens" aria-pressed="true">Active</button>
                    <button type="button" class="dropdown-item" data-token-filter="InactiveTokens" aria-pressed="false">Inactive</button>
                </div>
            </div>
        </div>
        <div>
            @foreach (var group in new[] { (Id: "ActiveTokens", Tokens: active), (Id: "InactiveTokens", Tokens: inactive) })
            {
                <section id="@group.Id" data-token-group hidden="@(group.Id != "ActiveTokens")" aria-label="@(group.Id == "ActiveTokens" ? "Active tokens" : "Inactive tokens")">
                    @if (group.Tokens.Length == 0)
                    {
                        <p class="text-muted py-4">@(group.Id == "ActiveTokens" ? "No active tokens. Create a token to connect your automation." : "Expired, revoked and invalidated tokens will appear here.")</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead><tr><th>Name / ID</th><th>Plugin</th><th>Last used</th><th>Expires</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                                <tbody>
                                @foreach (var token in group.Tokens)
                                {
                                    var status = token.RevokedAt is not null ? "Revoked" : token.Invalidated ? "Invalidated"
                                        : token.ExpiresAt is { } expires && expires <= now ? "Expired" : "Active";
                                    <tr data-token-id="@token.Id">
                                        <td class="text-break">
                                            <span data-token-name>@token.Name</span>
                                            <div><button type="button" class="btn btn-link btn-sm p-0" data-copy-id="@token.Id" title="Copy token ID: @token.Id" aria-label="Copy token ID for @token.Name"><code>@(token.Id.ToString()[..8])…</code></button></div>
                                            <div class="small text-muted" title="@token.CreatedAt.ToString("u")">Created @token.CreatedAt.ToString("yyyy-MM-dd")</div>
                                        </td>
                                        <td><code>@token.PluginSlug</code></td>
                                        <td class="text-nowrap" title="@token.LastUsedAt?.ToString("u")">@(token.LastUsedAt is { } used ? (now - used).ToTimeAgo() : "Never")</td>
                                        <td class="text-nowrap" title="@token.ExpiresAt?.ToString("u")">@(token.ExpiresAt?.ToString("yyyy-MM-dd") ?? "Never")</td>
                                        <td><span data-token-status class="badge @(status == "Active" ? "bg-success" : status == "Expired" ? "bg-warning" : "bg-secondary")">@status</span></td>
                                        <td class="text-end">
                                            @if (token.RevokedAt is null)
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#ConfirmModal" data-action="@Url.Action("Revoke", new { id = token.Id })" data-title="Revoke @token.Name?">Revoke</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        </div>
    </div>
    <p id="TokenCopyStatus" class="small text-muted" role="status"></p>
</div>

<div class="modal fade" id="CreateTokenModal" tabindex="-1" aria-labelledby="CreateTokenTitle" aria-hidden="true" data-open="@((Model.Issued is not null || !ViewData.ModelState.IsValid) ? "true" : "false")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="CreateTokenTitle">@(Model.Issued is null ? "Create token" : "Token created")</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><vc:icon symbol="close" /></button>
            </div>
            <form id="CreateTokenForm" asp-action="Create" method="post" hidden="@(Model.Issued is not null)">
                <div class="modal-body">
                    <p class="text-muted">This token can manage builds and versions for the plugin you choose. It works with two-factor authentication.</p>
                    <div id="TokenValidation" asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <div id="TokenCreationError" class="alert alert-danger" role="alert" hidden></div>
                    <div class="mb-3">
                        <label asp-for="Creation.Name" class="form-label">Token name</label>
                        <input asp-for="Creation.Name" class="form-control" maxlength="100" placeholder="e.g. GitHub Actions release" autocomplete="off" required />
                        <div class="form-text">Choose a name that identifies the agent or automation.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Creation.PluginSlug" class="form-label">Plugin</label>
                        <select asp-for="Creation.PluginSlug" class="form-select" required>
                            @foreach (var plugin in Model.Plugins)
                            {
                                <option value="@plugin">@plugin</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="TokenLifetime" class="form-label">Expires in</label>
                        <select id="TokenLifetime" class="form-select">
                            <option value="7">7 days</option>
                            <option value="30">30 days</option>
                            <option value="90" selected>90 days</option>
                            <option value="custom">Custom</option>
                            <option value="0">Never</option>
                        </select>
                    </div>
                    <div id="CustomTokenLifetime" class="mb-3" hidden>
                        <label asp-for="Creation.ExpiresInDays" class="form-label">Number of days</label>
                        <input asp-for="Creation.ExpiresInDays" class="form-control" type="number" min="1" max="365" required aria-describedby="TokenExpiryPreview" />
                    </div>
                    <p id="TokenExpiryPreview" class="form-text mb-0" aria-live="polite"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Create token</button>
                </div>
            </form>
            <div id="TokenSuccess" hidden="@(Model.Issued is null)">
                @if (Model.Issued is { } issued)
                {
                    <div class="modal-body">
                        <div class="alert alert-success">Token created. Save it now: it will not be shown again.</div>
                        <p><strong>@Model.Creation.Name</strong><br /><span class="text-muted">@issued.PluginSlug · @(issued.ExpiresAt is { } expiry ? $"Expires {expiry:u}" : "Never expires")</span></p>
                        <label for="IssuedToken" class="form-label">Your token</label>
                        <div class="input-group">
                            <input id="IssuedToken" class="form-control font-monospace" value="@issued.Token" readonly autocomplete="off" spellcheck="false" />
                            <button type="button" class="btn btn-secondary" data-copy="token" aria-label="Copy token" title="Copy token"><span aria-hidden="true"><vc:icon symbol="copy" /></span></button>
                        </div>
                        <p class="form-text mt-3 mb-0">Use it as <code>Authorization: Bearer &lt;token&gt;</code>. Changing your password or two-factor settings invalidates existing tokens.</p>
                        <p id="SecretCopyStatus" class="small mt-3 mb-0" role="status"></p>
                        <div id="SecretCopyFallback" class="mt-3" hidden>
                            <label for="SecretCopyText" class="form-label">Select and copy this text</label>
                            <textarea id="SecretCopyText" class="form-control font-monospace" rows="4" readonly spellcheck="false"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button></div>
                }
            </div>
        </div>
    </div>
</div>

@section FooterScripts {
    <partial name="_Confirm" model='new ConfirmModel("Revoke token", "The token stops working immediately. Requests already running may finish. This cannot be undone.", "Revoke token")' />
    <script>
        (() => {
            const root = document.getElementById('PublisherTokens');
            const modal = document.getElementById('CreateTokenModal');
            const form = document.getElementById('CreateTokenForm');
            const success = document.getElementById('TokenSuccess');
            const title = document.getElementById('CreateTokenTitle');
            const lifetime = document.getElementById('TokenLifetime');
            const days = document.getElementById('Creation_ExpiresInDays');
            const submit = form.querySelector('[type="submit"]');
            const error = document.getElementById('TokenCreationError');
            let pending = false;

            function updateExpiry() {
                const never = lifetime.value === '0';
                document.getElementById('CustomTokenLifetime').hidden = lifetime.value !== 'custom';
                if (lifetime.value !== 'custom') days.value = lifetime.value;
                days.min = never ? '0' : '1';
                const valid = days.checkValidity();
                const expiry = new Date(Date.now() + Number(days.value) * 86400000);
                document.getElementById('TokenExpiryPreview').textContent = never ? 'Never expires.' : valid
                    ? `Expires ${expiry.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}.`
                    : 'Choose between 1 and 365 days.';
            }

            lifetime.value = ['7', '30', '90', '0'].includes(days.value) ? days.value : 'custom';
            updateExpiry();
            lifetime.addEventListener('change', updateExpiry);
            days.addEventListener('input', updateExpiry);
            modal.addEventListener('shown.bs.modal', () => {
                (success.querySelector('[data-copy="token"]') || document.getElementById('Creation_Name')).focus();
            });
            modal.addEventListener('hide.bs.modal', event => {
                if (pending) event.preventDefault();
            });
            modal.addEventListener('hidden.bs.modal', () => {
                success.replaceChildren();
                success.hidden = true;
                form.hidden = false;
                title.textContent = 'Create token';
                form.reset();
                document.getElementById('Creation_Name').value = '';
                document.getElementById('TokenValidation').replaceChildren();
                lifetime.value = '90';
                updateExpiry();
                error.hidden = true;
                submit.disabled = false;
            });

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!modal.classList.contains('show') || form.hidden || submit.disabled) return;
                pending = true;
                submit.disabled = true;
                submit.textContent = 'Creating…';
                error.hidden = true;
                try {
                    const response = await fetch(form.action, {
                        method: 'POST', body: new FormData(form), credentials: 'same-origin',
                        headers: { 'Accept': 'text/html' }
                    });
                    if (!response.ok || response.redirected) throw new Error('Creation response unavailable');
                    const result = new DOMParser().parseFromString(await response.text(), 'text/html');
                    const issued = result.getElementById('TokenSuccess');
                    const list = result.getElementById('TokenList');
                    const validation = result.getElementById('TokenValidation');
                    if (!issued || !list || !validation) throw new Error('Creation response unavailable');
                    if (issued.querySelector('#IssuedToken')) {
                        success.replaceChildren(...issued.childNodes);
                        document.getElementById('TokenList').replaceChildren(...list.childNodes);
                        form.hidden = true;
                        success.hidden = false;
                        title.textContent = 'Token created';
                        success.querySelector('[data-copy="token"]').focus();
                    } else {
                        document.getElementById('TokenValidation').replaceWith(validation);
                    }
                    submit.disabled = false;
                } catch {
                    error.textContent = 'We could not confirm whether the token was created. Reload this page and check the token list. Revoke any new token you could not save before creating another.';
                    error.hidden = false;
                } finally {
                    pending = false;
                    submit.textContent = 'Create token';
                }
            });

            success.addEventListener('click', async event => {
                if (!event.target.closest('[data-copy="token"]')) return;
                const token = success.querySelector('#IssuedToken').value;
                const status = success.querySelector('#SecretCopyStatus');
                try {
                    await navigator.clipboard.writeText(token);
                    if (!success.contains(status)) return;
                    status.textContent = 'Token copied.';
                    success.querySelector('#SecretCopyFallback').hidden = true;
                    success.querySelector('#SecretCopyText').value = '';
                } catch {
                    if (!success.contains(status)) return;
                    status.textContent = 'Clipboard access is unavailable. Copy the selected text manually.';
                    success.querySelector('#SecretCopyFallback').hidden = false;
                    const field = success.querySelector('#SecretCopyText');
                    field.value = token;
                    field.focus();
                    field.select();
                }
            });

            root.addEventListener('click', async event => {
                const filter = event.target.closest('[data-token-filter]');
                if (filter) {
                    root.querySelectorAll('[data-token-filter]').forEach(item => {
                        const selected = item === filter;
                        item.classList.toggle('active', selected);
                        item.setAttribute('aria-pressed', selected);
                    });
                    root.querySelectorAll('[data-token-group]').forEach(group => {
                        group.hidden = group.id !== filter.dataset.tokenFilter;
                    });
                    document.getElementById('TokenStatusFilter').textContent = `Status: ${filter.textContent.trim()}`;
                    return;
                }
                const button = event.target.closest('[data-copy-id]');
                if (!button) return;
                const status = document.getElementById('TokenCopyStatus');
                try {
                    await navigator.clipboard.writeText(button.dataset.copyId);
                    status.textContent = 'Token ID copied.';
                } catch {
                    status.textContent = `Token ID: ${button.dataset.copyId}. Select and copy it manually.`;
                }
            });

            if (modal.dataset.open === 'true') bootstrap.Modal.getOrCreateInstance(modal).show();
        })();
    </script>
}
