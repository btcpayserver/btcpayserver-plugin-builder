@{
    var isDetails = ViewContext.RouteData.Values["action"]?.ToString() == "AccountDetails";
    var isTokens = ViewContext.RouteData.Values["controller"]?.ToString() == "PublisherTokenSettings";
    var isTwoFactor = !isDetails && !isTokens;
}

<nav id="SectionNav" class="account-nav mb-4" aria-label="Account settings">
    <div class="nav nav-pills gap-4">
        <a asp-controller="Account" asp-action="AccountDetails"
           class="nav-link @(isDetails ? "active" : null)" aria-current="@(isDetails ? "page" : null)">
            Account details
        </a>
        <a asp-controller="Account" asp-action="TwoFactorAuthentication" id="TwoFactorSettings"
           class="nav-link @(isTwoFactor ? "active" : null)" aria-current="@(isTwoFactor ? "page" : null)">
            2FA
        </a>
        <a asp-controller="PublisherTokenSettings" asp-action="Index" id="ManageApiTokens"
           class="nav-link @(isTokens ? "active" : null)" aria-current="@(isTokens ? "page" : null)">
            API tokens
        </a>
    </div>
</nav>
