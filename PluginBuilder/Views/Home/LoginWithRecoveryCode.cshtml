@model LoginWithRecoveryCodeViewModel
@{
    ViewData["Title"] = "Sign in with a recovery code";
    Layout = "_LayoutHomeModal";
}

<div class="row justify-content-center mb-2">
    <div class="col text-center">
        <a tabindex="-1" href="/">
            <img src="~/img/btcpay-logo.svg" alt="BTCPay Server" class="mb-4" height="70" />
        </a>
        <h1 class="h2 mb-3">Welcome to BTCPay&nbsp;Server Plugin Builder</h1>
    </div>
</div>
<div class="account-form">
    <h4>@ViewData["Title"]</h4>
    <p>Enter one of the recovery codes you saved when you set up two-factor authentication. Each code works once.</p>
    <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="login-recovery-form" asp-action="LoginWithRecoveryCode">
        <fieldset>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RecoveryCode" class="form-label"></label>
                <input asp-for="RecoveryCode" class="form-control" autocomplete="off" required autofocus tabindex="1" />
                <span asp-validation-for="RecoveryCode" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary btn-lg w-100" id="LoginWithRecoveryCodeButton" tabindex="2">Sign in</button>
            </div>
        </fieldset>
    </form>
</div>
