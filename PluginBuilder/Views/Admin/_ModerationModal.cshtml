<div class="modal fade" id="UserModerationModal" tabindex="-1" aria-labelledby="ModerationTitle" aria-describedby="ModerationDescription" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="ModerationForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h4 class="modal-title" id="ModerationTitle"></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><vc:icon symbol="close" /></button>
                </div>
                <div class="modal-body">
                    <div id="ModerationBanTypeField" class="mb-3" hidden>
                        <label for="ModerationBanType" class="form-label">Type</label>
                        <select id="ModerationBanType" name="Kind" class="form-select" required disabled>
                            <option value="github">GitHub</option>
                            <option value="email-domain" selected>Email domain</option>
                            <option value="ip">IP</option>
                        </select>
                    </div>
                    <p id="ModerationTarget" class="fw-semibold text-break"></p>
                    <p id="ModerationDescription"></p>
                    <div id="ModerationSignupIpField" class="mb-3" hidden>
                        <div class="form-label">Signup IP (banned only if eligible)</div>
                        <code id="ModerationSignupIp"></code>
                    </div>
                    <div id="ModerationError" class="alert alert-danger" role="alert" tabindex="-1" hidden></div>
                    <div id="ModerationBanTargetField" class="mb-3" hidden>
                        <label for="ModerationBanTarget" id="ModerationBanTargetLabel" class="form-label">Domain</label>
                        <input id="ModerationBanTarget" name="Target" class="form-control" required maxlength="253"
                               autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="ModerationBanTargetHelp" disabled />
                        <div id="ModerationBanTargetHelp" class="form-text"></div>
                    </div>
                    <div class="mb-3">
                        <label for="ModerationReason" class="form-label">Reason <span class="text-danger" aria-hidden="true">*</span></label>
                        <textarea id="ModerationReason" name="Reason" class="form-control" rows="3" required maxlength="1000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="ModerationSubmit" type="submit" class="btn btn-primary"></button>
                </div>
            </form>
        </div>
    </div>
</div>
