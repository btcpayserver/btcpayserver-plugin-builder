@model EmailSenderViewModel
@{
    Layout = "_Layout";
    ViewData.SetActivePage(AdminNavPages.EmailSettings, "Email Test");
}

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        @if (Model.AcceptedRecipients.Count > 0)
        {
            <div id="accepted-recipients" class="mb-3">
                <strong>Accepted by the mail server</strong>
                <ul>
                    @foreach (var recipient in Model.AcceptedRecipients)
                    {
                        <li>@recipient</li>
                    }
                </ul>
            </div>
        }
        @if (Model.UncertainRecipient is not null)
        {
            <div id="uncertain-recipient" class="alert alert-warning">
                <strong>Delivery unconfirmed: @Model.UncertainRecipient</strong>
                <p class="mb-0">Check the mail server's logs before sending to this address again. The server may already have accepted the message, so it has been removed from the recipient field.</p>
            </div>
        }
        <form asp-action="EmailSender">
            <div class="form-group">
                <label asp-for="From" class="form-label"></label>
                <input asp-for="From" class="form-control" readonly />
                <span asp-validation-for="From" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="To" class="form-label"></label>
                <textarea asp-for="To" class="form-control" rows="5" placeholder="Enter recipient email addresses, separated by commas"></textarea>
                <span asp-validation-for="To" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Message" class="form-label"></label>
                <textarea asp-for="Message" class="form-control" rows="8"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" class="btn btn-primary" value="Send Email" />
            </div>
        </form>
    </div>
</div>
